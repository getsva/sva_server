# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
# Set to 'development' for local dev, 'production' for production
# This controls various settings automatically
ENVIRONMENT=development

# =============================================================================
# DJANGO CORE SETTINGS
# =============================================================================
# Secret key for Django - CHANGE THIS IN PRODUCTION!
# Generate a new one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Debug mode - automatically set based on ENVIRONMENT if not specified
# Set to False in production for security
DEBUG=True

# Allowed hosts - comma-separated list of hostnames
# Add your production domain here when deploying
ALLOWED_HOSTS=127.0.0.1,localhost

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Database connection string
# Format: postgresql://user:password@host:port/database
# For local SQLite: sqlite:///db.sqlite3
# For Azure PostgreSQL: postgres://user:password@host:port/database?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# Database SSL requirement - set to True for production databases
DB_SSL_REQUIRE=False

# =============================================================================
# CORS SETTINGS
# =============================================================================
# Comma-separated list of allowed origins for CORS
# Add your production frontend URL here
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000

# =============================================================================
# INTERNAL SERVICE-TO-SERVICE COMMUNICATION
# =============================================================================
# Token for internal service authentication
# Use a strong random string in production
INTERNAL_SERVICE_TOKEN=dev-shared-secret

# Header name for internal service token
INTERNAL_SERVICE_HEADER=X-Service-Token

# Base URL for SVA Auth Server
# Development: http://localhost:8001
# Production: Set to your production auth server URL
SVA_AUTH_SERVER_BASE_URL=http://localhost:8001

# Timeout for internal service requests in seconds
INTERNAL_SERVICE_TIMEOUT=5
# Timeout for auth-request-details (attest-data) in seconds; increase if OAuth server is slow
AUTH_REQUEST_DETAILS_TIMEOUT=25

# =============================================================================
# DATA TOKEN SETTINGS
# =============================================================================
# Secret key for data tokens - must match sva_oauth backend
# Use a strong random string in production
DATA_TOKEN_SECRET=dev-data-token-secret

# Algorithm for data token signing
DATA_TOKEN_ALGORITHM=HS256

# Time-to-live for data tokens in seconds (5 minutes default)
DATA_TOKEN_TTL_SECONDS=300

# Issuer identifier for data tokens
DATA_TOKEN_ISSUER=sva_core

# =============================================================================
# EMAIL SETTINGS FOR PASSWORD RESET
# =============================================================================
# Email backend - automatically set based on ENVIRONMENT
# Options: smtp (production) or console (development)
EMAIL_BACKEND=smtp

# SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Email credentials
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Default from email address
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# =============================================================================
# ZERO-KNOWLEDGE PEPPER CONSTANTS
# =============================================================================
# Public pepper - known to clients, used for initial hashing
# Change this in production for security
SVA_PUBLIC_PEPPER=sva-public-pepper-2024-zero-knowledge-uniqueness-check

# Secret server pepper - server-only, never expose this value
# CHANGE THIS IN PRODUCTION - use a strong random string
SVA_SECRET_SERVER_PEPPER=sva-secret-server-pepper-2024-never-expose-this-value

# =============================================================================
# PRODUCTION SECURITY SETTINGS (Optional)
# =============================================================================
# Force SSL redirect in production (default: True)
# SECURE_SSL_REDIRECT=True
